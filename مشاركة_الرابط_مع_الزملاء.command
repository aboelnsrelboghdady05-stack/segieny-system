#!/bin/bash
# ========================================================
# شركة مقاولات السجيني - مشاركة المنظومة فوراً مع الزملاء
# ========================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

clear
echo "================================================================="
echo "    شركة مقاولات السجيني - المنظومة الرقمية لإدارة المشاريع"
echo "================================================================="
echo ""

# 1. التأكد من تشغيل السيرفر أولاً
if ! curl -s http://localhost:5001 > /dev/null 2>&1; then
    echo "✓ جاري تشغيل المنظومة على جهازك..."
    ./venv/bin/python3 app.py > /dev/null 2>&1 &
    sleep 2
else
    echo "✓ المنظومة تعمل الآن على جهازك."
fi

echo ""
echo "================================================================="
echo " 🌐 جاري إنشاء رابط إنترنت مباشر لزملائك..."
echo " انسخ الرابط (https://...) الذي سيظهر بالأسفل باللون الأخضر"
echo " وأرسله لزملائك في الواتساب — سيفتح عندهم فوراً على الهاتف أو اللابتوب!"
echo ""
echo " ⚠️ ملاحظة: اترك هذه الشاشة مفتوحة أثناء مشاهدة الزملاء للموقع."
echo "================================================================="
echo ""

# تشغيل الرابط الفوري
ssh -p 443 -R0:localhost:5001 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 a.pinggy.io || ssh -R 80:localhost:5001 -o StrictHostKeyChecking=no nokey@localhost.run
